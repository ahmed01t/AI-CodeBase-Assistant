{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "AI CodeBase Assistant API",
    "description": "Complete Postman Collection for AI-CodeBase-Assistant covering all 10 modules: Health, Organizations, Organization Members, Projects, Repositories, GitHub Integration, Ingestion, Knowledge RAG Search, Conversations (Chat & SSE Streaming), and GitHub Webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "token", "value": "YOUR_SUPABASE_JWT_ACCESS_TOKEN", "type": "string" },
    { "key": "organizationId", "value": "123e4567-e89b-12d3-a456-426614174000", "type": "string" },
    { "key": "projectId", "value": "123e4567-e89b-12d3-a456-426614174001", "type": "string" },
    { "key": "repositoryId", "value": "123e4567-e89b-12d3-a456-426614174002", "type": "string" },
    { "key": "conversationId", "value": "123e4567-e89b-12d3-a456-426614174003", "type": "string" },
    { "key": "webhookSecret", "value": "your_webhook_secret", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "2. Organizations",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Corporation\",\n  \"slug\": \"acme-corp\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/organizations", "host": ["{{baseUrl}}"], "path": ["organizations"] }
          }
        },
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/organizations", "host": ["{{baseUrl}}"], "path": ["organizations"] }
          }
        },
        {
          "name": "Get Organization by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/organizations/{{organizationId}}", "host": ["{{baseUrl}}"], "path": ["organizations", "{{organizationId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organizationId\": \"{{organizationId}}\",\n  \"name\": \"Core Backend API\",\n  \"description\": \"Main Express TypeScript service\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["projects", "{{projectId}}"] }
          }
        }
      ]
    },
    {
      "name": "4. Repositories",
      "item": [
        {
          "name": "Create Repository Record",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"provider\": \"github\",\n  \"externalId\": \"12345678\",\n  \"owner\": \"ahmed01t\",\n  \"name\": \"AI-CodeBase-Assistant\",\n  \"url\": \"https://github.com/ahmed01t/AI-CodeBase-Assistant\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/repositories", "host": ["{{baseUrl}}"], "path": ["repositories"] }
          }
        },
        {
          "name": "List All Repositories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/repositories", "host": ["{{baseUrl}}"], "path": ["repositories"] }
          }
        },
        {
          "name": "Get Repository by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/repositories/{{repositoryId}}", "host": ["{{baseUrl}}"], "path": ["repositories", "{{repositoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "5. GitHub Integration",
      "item": [
        {
          "name": "List User Repositories from GitHub",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/github/repos", "host": ["{{baseUrl}}"], "path": ["github", "repos"] }
          }
        }
      ]
    },
    {
      "name": "6. Ingestion Pipeline",
      "item": [
        {
          "name": "Trigger Repository Sync (Full Ingestion)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branch\": \"main\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/ingestion/sync/{{repositoryId}}", "host": ["{{baseUrl}}"], "path": ["ingestion", "sync", "{{repositoryId}}"] }
          }
        }
      ]
    },
    {
      "name": "7. Knowledge (Semantic RAG Search)",
      "item": [
        {
          "name": "Semantic Search Codebase",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"query\": \"authentication middleware and JWT verification\",\n  \"limit\": 5,\n  \"similarityThreshold\": 0.4\n}"
            },
            "url": { "raw": "{{baseUrl}}/knowledge/search", "host": ["{{baseUrl}}"], "path": ["knowledge", "search"] }
          }
        }
      ]
    },
    {
      "name": "8. Conversations & AI Agent",
      "item": [
        {
          "name": "Create Conversation Thread",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"title\": \"Auth Flow Explanation\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/conversations", "host": ["{{baseUrl}}"], "path": ["conversations"] }
          }
        },
        {
          "name": "List Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/conversations?projectId={{projectId}}", "host": ["{{baseUrl}}"], "path": ["conversations"], "query": [{ "key": "projectId", "value": "{{projectId}}" }] }
          }
        },
        {
          "name": "Get Conversation with Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/conversations/{{conversationId}}", "host": ["{{baseUrl}}"], "path": ["conversations", "{{conversationId}}"] }
          }
        },
        {
          "name": "Send Message to Agent (JSON Response)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"How does the user authentication middleware work in this codebase?\",\n  \"repositoryId\": \"{{repositoryId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages", "host": ["{{baseUrl}}"], "path": ["conversations", "{{conversationId}}", "messages"] }
          }
        },
        {
          "name": "Send Message to Agent (Real-Time SSE Stream)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Explain how the ingestion pipeline chunks code and generates embeddings.\",\n  \"repositoryId\": \"{{repositoryId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages/stream", "host": ["{{baseUrl}}"], "path": ["conversations", "{{conversationId}}", "messages", "stream"] }
          }
        }
      ]
    },
    {
      "name": "9. GitHub Webhooks",
      "item": [
        {
          "name": "Webhook Handshake (Ping)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-GitHub-Event", "value": "ping" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zen\": \"Design for failure.\",\n  \"hook_id\": 12345678\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/github", "host": ["{{baseUrl}}"], "path": ["webhooks", "github"] }
          }
        },
        {
          "name": "Webhook Push Event (Incremental Re-indexing)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-GitHub-Event", "value": "push" },
              { "key": "X-GitHub-Delivery", "value": "d6a8b1c2-3e4f-5a6b-7c8d-9e0f1a2b3c4d" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ref\": \"refs/heads/main\",\n  \"repository\": {\n    \"id\": 12345678,\n    \"name\": \"AI-CodeBase-Assistant\",\n    \"full_name\": \"ahmed01t/AI-CodeBase-Assistant\",\n    \"html_url\": \"https://github.com/ahmed01t/AI-CodeBase-Assistant\",\n    \"default_branch\": \"main\"\n  },\n  \"commits\": [\n    {\n      \"id\": \"commit-sha-123\",\n      \"message\": \"Update auth middleware\",\n      \"added\": [],\n      \"modified\": [\"src/middleware/auth.middleware.ts\"],\n      \"removed\": []\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/webhooks/github", "host": ["{{baseUrl}}"], "path": ["webhooks", "github"] }
          }
        }
      ]
    }
  ]
}
